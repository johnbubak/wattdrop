# ==============================================================================
# WATTDROP — ECO-PERFORMANCE SERVER-SIDE DROP-IN (Apache .htaccess)
# ==============================================================================
# 1. Stops 404 spam for icons and missing images
# 2. Speeds up JS/CSS with hard caching and gzip compression
#
# Drop this file into your web root (or the document root of the site you
# want to protect). Requires AllowOverride All (or at least FileInfo,
# Indexes, and mod_rewrite) on the directory.
# ==============================================================================

# --- PART 1: Zero-Icon (the core of WattDrop) ---
# Missing standard icons get 204 No Content — real icon files on disk are
# served normally. The application behind Apache never wakes up for missing
# icons.
#
# Verified (Apache 2.4): [R=204] works and sends no body/Location header.
# In per-directory context (.htaccess), patterns must NOT start with a slash.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Real files always win — serve them normally, stop rewriting.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule .* - [L]

    # Missing standard icons -> 204 No Content (maximum eco mode).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(favicon\.ico|favicon-16x16\.png|favicon-32x32\.png|apple-touch-icon.*\.png)$ - [R=204,L]
</IfModule>

# --- PART 2: Graceful Image Fallback ---
# Broken images don't throw errors; they get a silent 1x1 SVG instead.
# Requires the bundled placeholder (wattdrop-missing.svg) next to this file.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files normally (stop rewriting for them)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule .* - [L]

    # Missing images -> silent placeholder SVG
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} \.(jpg|jpeg|png|gif|webp)$ [NC]
    RewriteRule .* wattdrop-missing.svg [L]
</IfModule>

# --- PART 3: JS & CSS Performance Turbo ---
# Modern browsers use HTTP/2 multiplexing. Don't hack your frontend to bundle
# scripts dynamically — aggressively cache and compress instead.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css application/javascript image/svg+xml
</IfModule>